.DS_Store
.env
/node_modules/

# React Router
/.react-router/
/build/

# SQLite
*.db
*.db-journal
*.db-wal
.pnpm-store
*.db-shm
.claude/settings.local.json
.claude/worktrees/

# JetBrains
/.idea/

# VS Code
.vscode/

# request-logger captured logs (may contain your own code/prompts)
/request-logger/logs/*
!/request-logger/logs/.gitkeep

# request-logger remembers which agent you chose
/request-logger/.agent-choice.json

# Screenshots and DOM readouts from the browser loop. Each run overwrites
# them, and they are local to one machine.
/screenshots/

# Stryker work files and reports. This includes the result cache of
# incremental mode (reports/stryker-incremental.json). Each file is local to
# one machine. Do not share these files, and do not commit them.
.stryker-tmp/
reports/
stryker.log

# Emails written locally instead of sent
.outbox/

# Hand-off files between the factory workflows and their agent: the ticket,
# the PR body, screenshots. Inside the checkout because the org policy keeps
# the agent out of /tmp. Written fresh on every run.
/.factory/
