# Knock (in-app Notifications). Leave KNOCK_API_KEY empty to write
# Notifications to .notifications/ instead of sending them to Knock.

# Secret API key (Platform -> API keys)
KNOCK_API_KEY=
# Public API key (Platform -> API keys)
KNOCK_PUBLIC_KEY=
# Signing key for feed user tokens (Platform -> API keys), PEM or base64 PEM
KNOCK_SIGNING_KEY=
# Optional, dev only: feed token lifetime in seconds (default 3600). Set e.g.
# 90 to check that token refresh keeps real-time working past expiry.
# KNOCK_TOKEN_TTL_SECONDS=
# UUID of the in-app feed channel (key "in-app"; Account settings -> Channels)
KNOCK_FEED_CHANNEL_ID=
# Service token for the Knock CLI (Account settings -> Service tokens)
KNOCK_SERVICE_TOKEN=
